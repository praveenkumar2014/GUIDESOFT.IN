# Example environment variables for auth-backend
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/guidesoft
SECRET_KEY=replace_with_secure_random_value
GOOGLE_CLIENT_ID=your-google-client-id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
CORS_ORIGINS=http://localhost:5174

# Payment provider placeholders (sandbox)
PAYU_KEY=your_payu_key
PAYU_SALT=your_payu_salt
PAYU_BASE_URL=https://sandbox.payu.in

CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET=your_cashfree_secret
CASHFREE_BASE_URL=https://sandbox.cashfree.com

# Google Pay / UPI placeholders
GUPI_MERCHANT_ID=your_gpay_merchant_id
GUPI_BASE_URL=https://pay.google.com/gp/p/ui/pay
