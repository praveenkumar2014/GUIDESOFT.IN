# Existing auth configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

BACKEND_REFRESH_TOKEN_URL=http://localhost:8000/api/token/refresh/
BACKEND_VERIFY_TOKEN_URL=http://localhost:8000/api/token/verify/
BACKEND_LOGOUT_TOKEN_URL=http://localhost:8000/api/token/logout/


# Optional app distribution links used by /download?auto=1
# Electron release URL or a direct installer URL for the desktop app.
VITE_ELECTRON_DOWNLOAD_URL=https://your-domain.example/downloads/GuideSoft-latest.dmg
# Optional platform-specific overrides.
VITE_DESKTOP_APP_URL=
VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=your.package.name
VITE_IOS_APP_URL=https://apps.apple.com/app/your-app/id0000000000
